DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio
TUSHARE_TOKEN=your_tushare_token
# P0-2 终态告警（opt-in）：任意 JSON POST webhook，留空=告警关闭
# COLLECTOR_ALERT_WEBHOOK=https://example.com/hook
# 邮件告警降级（opt-in）：飞书 webhook 发送失败时改走 SMTP 邮件兜底送达；
# 与 backend MAIL_* 命名一致（可共用同一组 SMTP 凭证），四要素 + 收件人配齐才启用
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM=
ALERT_MAIL_TO=
