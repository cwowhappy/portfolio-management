# DeepSeek API Key（必填，用于 AI 对话；不填则仅行情数据可用）
DEEPSEEK_API_KEY=

# 可选配置
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 后端服务端口（server.port）；前端固定 3000，不要使用此变量
PORT=8080

# npm 镜像源（构建前端镜像时使用；国内网络建议 registry.npmmirror.com）
NPM_REGISTRY=https://registry.npmjs.org/

# PostgreSQL
POSTGRES_USER=invest
POSTGRES_PASSWORD=invest
POSTGRES_DB=invest
# 内置管理员（首次启动种子，未填则不创建）
ADMIN_USERNAME=
ADMIN_PASSWORD=
# remember-me 签名 key（必填，任意随机串，如 openssl rand -hex 32）
REMEMBER_ME_KEY=

# 采集服务（collector，tushare 行情/财务数据源；非 Docker 部署另需 DATABASE_URL）
TUSHARE_TOKEN=
# 告警（opt-in）：FEISHU_BOT_WEBHOOK 优先（飞书群自定义机器人，卡片+可选签名）；
# COLLECTOR_ALERT_WEBHOOK 为通用 JSON POST 逃生通道；均未配置时告警静默关闭
FEISHU_BOT_WEBHOOK=
# 飞书机器人签名密钥（群机器人安全设置选「签名校验」时必填，否则留空）
FEISHU_BOT_SECRET=
COLLECTOR_ALERT_WEBHOOK=
# 飞书自建应用（P1 原则预警推送；留空则预警静默关闭）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 预警目标群 chat_id（oc_ 前缀；群设置页可复制）
FEISHU_ALERT_CHAT_ID=
# 巡检用户名（默认回落 ADMIN_USERNAME）
FEISHU_OWNER_USERNAME=
# P2 飞书对话（opt-in）：true 启用单聊对话；owner-open-id 留空时首条消息会在 backend 日志
# 打印 sender open_id（"飞书消息来自 open_id=..."），回填后重启生效
FEISHU_DIALOGUE_ENABLED=false
FEISHU_OWNER_OPEN_ID=
