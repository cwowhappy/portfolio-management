# DeepSeek API Key（必填，用于 AI 对话；不填则仅行情数据可用）
DEEPSEEK_API_KEY=

# 可选配置
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=8080

# npm 镜像源（构建前端镜像时使用；国内网络建议 registry.npmmirror.com）
NPM_REGISTRY=https://registry.npmjs.org/

# PostgreSQL
POSTGRES_USER=invest
POSTGRES_PASSWORD=invest
POSTGRES_DB=invest
# 内置管理员（首次启动种子，未填则不创建）
ADMIN_USERNAME=
ADMIN_PASSWORD=
